# =========================================================
# 1. PATH (ultra limpo + sem duplicados)
# =========================================================
typeset -U path
path=(
  $HOME/.local/bin
  $HOME/.bin
  $HOME/bin
  $HOME/Work/cmd-line-importer
  $HOME/.rvm/bin
  /Applications/Visual\ Studio\ Code.app/Contents/Resources/app/bin
  $path
)
export PATH


# =========================================================
# 2. CORE (mínimo absoluto)
# =========================================================
export EDITOR=vim

alias vi='vim'
alias rm='rm -i'
alias ll='ls -laG'


# =========================================================
# 3. ULTRA FAST PROMPT (sem frameworks)
# =========================================================
autoload -Uz vcs_info
precmd() {
  vcs_info 2>/dev/null
}

zstyle ':vcs_info:git:*' formats '(%b)'

setopt PROMPT_SUBST
export PS1='%1~ ${vcs_info_msg_0_}%# '


# =========================================================
# 4. NVM ULTRA FAST (lazy + async + project-aware)
# =========================================================
export NVM_DIR="$HOME/.nvm"

nvm() {
  unset -f nvm node npm npx
  source "$NVM_DIR/nvm.sh"
  nvm "$@"
}

autoload -Uz add-zsh-hook

__node_loaded=0

load_node() {
  [[ $__node_loaded -eq 1 ]] && return
  __node_loaded=1

  [[ -f .nvmrc ]] && nvm use >/dev/null 2>&1 || nvm use --lts >/dev/null 2>&1
}

add-zsh-hook chpwd load_node


# =========================================================
# 5. ZSH COMPLETION (rápido cacheado)
# =========================================================
# cache de completion (grande speedup)
ZSH_COMPDUMP="$HOME/.zcompdump"
autoload -Uz compinit
compinit -C -d "$HOME/.zcompdump"

# =========================================================
# 6. SMART HISTORY (tipo IDE search)
# =========================================================
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY


# =========================================================
# 7. FUZZY SEARCH (fzf-like history)
# =========================================================
if command -v fzf >/dev/null 2>&1; then
  bindkey '^R' fzf-history-widget
fi


# =========================================================
# 8. PERFORMANCE DEBUG TOOL (DEBUG MODE)
# =========================================================
zsh_startup_time() {
  for i in {1..5}; do
    time zsh -i -c exit
  done
}


# =========================================================
# 9. FUNCTIONS (limpas e rápidas)
# =========================================================

rtmux() {
  local server=$1
  shift
  autossh -M 0 -t "$server" "$@" \
    "tmux -qu has -t mimes && tmux -qu attach -t mimes || tmux -qu new -s mimes"
}

listening() {
  if [[ $# -eq 0 ]]; then
    sudo lsof -iTCP -sTCP:LISTEN -n -P +c 0
  else
    sudo lsof -iTCP -sTCP:LISTEN -n -P +c 0 | grep -i --color "$1"
  fi
}


# =========================================================
# 10. COB (lazy init)
# =========================================================
if command -v cob >/dev/null 2>&1; then
  eval "$(cob init -)"
fi

[[ -f "$HOME/.cob-cli/completion.sh" ]] && source "$HOME/.cob-cli/completion.sh"


# =========================
# 11. Console VI MODE (turbo)
# =========================
bindkey -v
export KEYTIMEOUT=1

# -------------------------
# Cursor diferente por modo
# -------------------------
zle-keymap-select() {
  [[ $KEYMAP == vicmd ]] && print -n "\e[1 q" || print -n "\e[5 q"
}
zle -N zle-keymap-select

zle-line-init() {
  print -n "\e[5 q"
}
zle -N zle-line-init

# -------------------------
# Histórico estilo IDE (Ctrl+R melhorado)
# -------------------------
if command -v fzf >/dev/null 2>&1; then
  # usa fzf se existir -> necessita do `brew install fzf` e do `brew install fd`
  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git --exclude node_modules --exclude .cache --exclude .cargo --exclude .Trash --exclude .aivm"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="fd --type d --hidden --exclude .git --exclude node_modules --exclude .cache --exclude .cargo --exclude .Trash --exclude .aivm"

    # cache para Alt+C
    _fzf_alt_c_cache="${HOME}/.cache/fzf-dirs-cache"

    # regenera cache se não existir ou tiver mais de 24h
    _fzf_alt_c_load_cache() {
      if [[ ! -f "$_fzf_alt_c_cache" ]] || \
         [[ -n "$(find "$_fzf_alt_c_cache" -mmin +1440 2>/dev/null)" ]]; then
        eval "$FZF_ALT_C_COMMAND" > "$_fzf_alt_c_cache"
      fi
    }

    # sobrepõe o widget Alt+C para usar cache
    fzf-cd-widget() {
      _fzf_alt_c_load_cache
      FZF_ALT_C_COMMAND="cat $_fzf_alt_c_cache" \
        __fzf_cd__
    }
    zle -N fzf-cd-widget

    # força actualização manual da cache
    fzf-refresh-cache() {
      echo "A actualizar cache..."
      eval "$FZF_ALT_C_COMMAND" > "$_fzf_alt_c_cache"
      echo "Feito! $(wc -l < $_fzf_alt_c_cache) directorias indexadas."
    }
    alias fzf-refresh='fzf-refresh-cache'
  fi

  if [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]]; then
    source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  elif [[ -f /usr/local/opt/fzf/shell/key-bindings.zsh ]]; then
    source /usr/local/opt/fzf/shell/key-bindings.zsh
  fi
else
  # fallback melhorado (incremental search)
  bindkey '^R' history-incremental-search-backward
fi

# -------------------------
# Navegação por palavra (sem Alt)
# -------------------------
# modo insert (atalhos úteis)
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^W' backward-kill-word

# =========================================================
# 12. Autosuggestions (ghost text) ->> brew install zsh-autosuggestions
# =========================================================
BREW_PREFIX=""
command -v brew >/dev/null && BREW_PREFIX=$(brew --prefix)

if [[ -f $BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source $BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi


# =========================================================
# 13. Syntax highlighting (lightweight) ->> brew install zsh-syntax-highlighting
# =========================================================
if [[ -f $BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source $BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi


# =========================================================
# 14. SOPS AGENT KEY (op read)
# =========================================================
export SOPS_AGE_KEY="$(op read "op://Private/Mimes personal Age Key/notesPlain" 2>/dev/null)"
