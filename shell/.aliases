# ~/.aliases — Aliases partilhados entre máquinas

# --- Dotfiles management ---
alias dotfiles='git -C ~/.dotfiles'
alias ds='dotfiles status'
alias da='dotfiles add -p'
alias dc='dotfiles commit'
alias dp='dotfiles push'
alias dl='dotfiles pull'

# --- Editores ---
alias vi='vim'

# --- Git shortcuts ---
alias g='git'
alias gs='git status'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias gf='git fetch --all'
alias glog='git log --oneline --graph --decorate -20'

# --- Navegação ---
alias ..='cd ..'
alias ...='cd ../..'
alias ll='ls -laG'
alias la='ls -A'

# --- Segurança: pedir confirmação ---
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'

# --- Dictate (whisper.cpp toggle) ---
alias dictate='~/.dotfiles/bin/dictate.sh'
alias transcribe='~/.dotfiles/bin/transcribe.sh'

# --- VS Code extensions sync ---
alias vscode-export='code --list-extensions > ~/.dotfiles/vscode/extensions.txt && echo "Extensions exportadas"'
alias vscode-import='while IFS= read -r ext; do code --install-extension "$ext" --force; done < ~/.dotfiles/vscode/extensions.txt'
