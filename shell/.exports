# ~/.exports — Variáveis de ambiente partilhadas

# Editores
export EDITOR=vim
export VISUAL="code --wait"

# Língua e locale
export LANG="pt_PT.UTF-8"
export LC_ALL="pt_PT.UTF-8"

# Cores no terminal
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

# Evitar ficheiros .pyc
export PYTHONDONTWRITEBYTECODE=1

# NVM
export NVM_DIR="$HOME/.nvm"

# FZF + fd (se disponíveis)
# WhisperX (diarização) — referência 1Password para o HF token; o
# transcribe-diarize.sh faz `op read` lazy. Override via env por sessão.
export WHISPERX_HF_TOKEN_OP_REF="op://Private/HuggingFace/token"

if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git --exclude node_modules --exclude .cache --exclude .cargo --exclude .Trash --exclude .aivm"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_GENERATE="fd --type d --hidden --exclude .git --exclude node_modules --exclude .cache --exclude .cargo --exclude .Trash --exclude .aivm"
fi
