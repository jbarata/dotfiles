# ~/.exports — Variáveis de ambiente partilhadas

# Editores
export EDITOR=vim
export VISUAL="code --wait"

# Língua e locale
# LANG mantém os formatos PT (datas, €, métrico); LC_MESSAGES põe as
# mensagens (git, etc.) em inglês. Sem LC_ALL — sobrepunha-se a tudo e
# forçava o output das ferramentas para português.
export LANG="pt_PT.UTF-8"
export LC_MESSAGES="en_US.UTF-8"

# Cores no terminal
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

# Evitar ficheiros .pyc
export PYTHONDONTWRITEBYTECODE=1

# NVM
export NVM_DIR="$HOME/.nvm"

# FZF + fd (se disponíveis)
# WhisperX (diarização) — referência 1Password para o HF token; o
# transcribe-diarize.sh faz `op read` lazy. Override via env por sessão.
export WHISPERX_HF_TOKEN_OP_REF="op://Private/HuggingFace/token"

if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND="fd --type f --hidden --exclude .git --exclude node_modules --exclude .cache --exclude .cargo --exclude .Trash --exclude .aivm"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_GENERATE="fd --type d --hidden --absolute-path --exclude .git --exclude node_modules --exclude .cache --exclude .cargo --exclude .Trash --exclude .aivm . $HOME"
fi


# aivm exports - Ajuste aos paths reais:
export AIVM_REPO=~/Work/OTHERS/ai_vm_generator
export TEMPLATE_NAME=tpl-cob-server-repo

export GH_USER=cob                                            # o teu username no GitHub
export EXTRA_REPO_1=git@github.com:$GH_USER/policies.git   # repo teu, acessível
export EXTRA_REPO_2=git@github.com:$GH_USER/learning.git   # outro, acessível

export CLIENT_REPO_A=~/Work/server_training          # um teu repo git real
export CLIENT_REPO_B=~/Work/server_learning          # outro teu repo git real

export EXTRA_REPO_3=git@github.com:$GH_USER/test-repo-3.git   # 3º, usado só na Fase F

export HOST_CLAUDE_MTIME_BEFORE=$(stat -f %m ~/.claude/settings.json 2>/dev/null || echo "n/a")
