# Ghostty — Terminal configuration
# Gerido por: https://github.com/mimes70/dotfiles

# =========================================================
# Font
# =========================================================
font-family = JetBrains Mono
font-size = 14
font-thicken = true

# =========================================================
# Theme
# =========================================================
theme = catppuccin-mocha

# =========================================================
# Window
# =========================================================
window-padding-x = 8
window-padding-y = 4
window-decoration = true
macos-titlebar-style = tabs
window-save-state = always

# =========================================================
# Cursor (alinha com vi mode do .zshrc)
# =========================================================
cursor-style = bar
cursor-style-blink = false

# =========================================================
# Mouse
# =========================================================
copy-on-select = clipboard
mouse-hide-while-typing = true

# =========================================================
# macOS
# =========================================================
# Só o Option ESQUERDO age como Alt (necessário para o Alt+C do fzf).
# O Option DIREITO fica livre como tecla de composição, para escrever
# "@" (⌥+2) e outros caracteres especiais do teclado português — com
# `true` o ⌥+2 enviava ESC+2 e tirava-te do modo insert do vi.
macos-option-as-alt = left

# =========================================================
# Keybindings (teclado português — sem [ e ])
# =========================================================
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+shift+i=prompt_surface_title

# =========================================================
# Shell
# =========================================================
shell-integration = zsh
# ssh-env define TERM=xterm-256color na sessão ssh — um terminfo que o
# remoto já conhece — resolvendo o "terminal is not fully functional" SEM
# instalar nada no host. (Sem ssh-terminfo, que tentaria escrever o
# terminfo xterm-ghostty no remoto.) Requer Ghostty ≥ 1.2.0.
shell-integration-features = ssh-env
