# skhdrc — Hotkeys globais para abrir apps/URLs
# Daemon: brew services start skhd (requer "Acessibilidade" no macOS)
# Docs: https://github.com/koekeishiya/skhd
#
# Convenção de teclas: cmd + alt - <letra>
#   - Evita conflitos frequentes de cmd+shift nas apps.
#   - Substitui o mecanismo antigo (Atalhos Mac → /tmp/uber-listener.log →
#     polling do links.widget). skhd dispara `open` directamente — sem
#     ficheiros temporários, sem polling, versionável neste repo.

# --- Apps principais -----------------------------------------------------
cmd + alt - z : open "zoommtg://zoom.us/join?confno=668244305&zc=2&browser=chrome&uname=Miguel"
cmd + alt - s : open "slack://open?team=T02J1N4KH"
cmd + alt - a : osascript -e 'tell application "Claude" to activate'
cmd + alt - g : open "https://chatgpt.com/pt-PT"
cmd + alt - v : open "vscode://"
cmd + alt - k : osascript "$HOME/.dotfiles/ubersicht/widgets/focus.widget/open_calendar.scpt"

# --- Cult of Bits --------------------------------------------------------
cmd + alt - d : open "https://dogfooding.cultofbits.com"
cmd + alt - p : open "https://dogfooding.cultofbits.com/recordm/index.html#/cob.custom-resource/Plan:{%22switchView%22:%22yes%22,%22concurrentFilterToggle%22:%22yes%22,%22showFilters%22:%22yes%22}/dash"
cmd + alt - o : open "https://dogfooding.cultofbits.com/recordm/index.html#/cob.custom-resource/Do/dash?"
cmd + alt - r : open "https://dogfooding.cultofbits.com/recordm/index.html#/cob.custom-resource/Review/dash?"

# --- Pessoal -------------------------------------------------------------
cmd + alt - m : open "https://mimes.cultofbits.com/recordm/index.html#/cob.custom-resource/Dia a Dia/dash"
cmd + alt - b : open "https://web.budgetbakers.com/dashboard"
cmd + alt - l : open "shortcuts://run-shortcut?name=Abrir%20AnyList"
