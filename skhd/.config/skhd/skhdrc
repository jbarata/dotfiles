# skhdrc — Hotkeys globais para abrir apps/URLs
# Daemon: brew services start skhd (requer "Acessibilidade" no macOS)
# Docs: https://github.com/koekeishiya/skhd
#
# Convenções de teclas:
#   - ctrl + alt + cmd - <letra>  : atalhos "Start X" herdados dos Atalhos
#     Mac (Calendar usa 't' e ChatGPT junta shift, para desambiguar com
#     Claude). Uma tecla, uma acção.
#   - ctrl + alt + cmd - d        : leader do modo "cob"
#                                   (p/o/r/d → Plan/Do/Review/Dogfooding).
#   - ctrl + alt + cmd - p        : leader do modo "personal"
#                                   (m/b/l → Mimes/BudgetBakers/AnyList).
#   - escape                      : cancela qualquer modo activo.
#
# Substitui o mecanismo antigo (Atalhos Mac → /tmp/uber-listener.log →
# polling do links.widget). skhd dispara `open` directamente.
# Excepções — ficheiros IPC dedicados:
#   /tmp/focus-review-toggle  ← review toggle do focus.widget
#   /tmp/skhd-mode            ← mode + cheatsheet para o skhd-hud.widget

# --- Modos ---------------------------------------------------------------
# @ = capture: teclas não ligadas ficam bloqueadas, evitando surpresas.
# Cada modo escreve em /tmp/skhd-mode (lido pelo skhd-hud.widget).
:: default : echo "" > /tmp/skhd-mode
:: cob @ : echo "cob|p·Plan   o·Do   r·Review   d·Dogfooding   esc·sair" > /tmp/skhd-mode
:: personal @ : echo "personal|m·Mimes   b·BudgetBakers   l·AnyList   esc·sair" > /tmp/skhd-mode

# --- Apps principais (convenção antiga: ctrl + alt + cmd) ----------------
ctrl + alt + cmd - z : open "zoommtg://zoom.us/join?confno=668244305&zc=2&browser=chrome&uname=Miguel"
ctrl + alt + cmd - s : open "slack://open?team=T02J1N4KH"
ctrl + alt + cmd - c : osascript -e 'tell application "Claude" to activate'
shift + ctrl + alt + cmd - c : open "https://chatgpt.com/pt-PT"
ctrl + alt + cmd - v : open "vscode://"
ctrl + alt + cmd - g : open -a "Ghostty"
ctrl + alt + cmd - t : osascript "$HOME/.dotfiles/ubersicht/widgets/focus.widget/open_calendar.scpt"
ctrl + alt + cmd - r : echo toggle > /tmp/focus-review-toggle

# --- Working Info (desktop de arquivo) -----------------------------------
cmd + alt - w        : "$HOME/.dotfiles/bin/open-working-info.sh"
ctrl + alt + cmd - w : "$HOME/.dotfiles/bin/desktop-tidy.sh"

# --- Leaders -------------------------------------------------------------
ctrl + alt + cmd - d ; cob
ctrl + alt + cmd - p ; personal

# --- Modo cob (dashboards CoB) -------------------------------------------
cob < p : open "https://dogfooding.cultofbits.com/recordm/index.html#/cob.custom-resource/Plan:{%22switchView%22:%22yes%22,%22concurrentFilterToggle%22:%22yes%22,%22showFilters%22:%22yes%22}/dash" ; default
cob < o : open "https://dogfooding.cultofbits.com/recordm/index.html#/cob.custom-resource/Do/dash?" ; default
cob < r : open "https://dogfooding.cultofbits.com/recordm/index.html#/cob.custom-resource/Review/dash?" ; default
cob < d : open "https://dogfooding.cultofbits.com" ; default
cob < escape ; default

# --- Modo personal (atalhos pessoais) ------------------------------------
personal < m : open "https://mimes.cultofbits.com/recordm/index.html#/cob.custom-resource/Dia a Dia/dash" ; default
personal < b : open "https://web.budgetbakers.com/dashboard" ; default
personal < l : open "shortcuts://run-shortcut?name=Abrir%20AnyList" ; default
personal < escape ; default
